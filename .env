# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# Placeholder only — real credentials belong in the gitignored .env.local, never here.
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/smartgpx?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Placeholder — dev/test use null transport by default; real SMTP DSN belongs in .env.local.
MAILER_DSN=null://null
MAILER_FROM_ADDRESS=no-reply@smartgpx.com
MAILER_FROM_NAME=SmartGPX
# Inbox the /contact form delivers to — never shown to end users, so a placeholder here is safe
# until a real support mailbox exists; override in .env.local once one does.
CONTACT_RECIPIENT_EMAIL=support@smartgpx.com
###< symfony/mailer ###

###> smartgpx/redis ###
# Placeholder — assumes a locally running Redis instance; override in .env.local if needed.
REDIS_URL="redis://127.0.0.1:6379"
###< smartgpx/redis ###

###> smartgpx/routing ###
# Placeholder — real key (Google Cloud Console, Routes API enabled) belongs in .env.local, never here.
GOOGLE_ROUTES_API_KEY=changeme
###< smartgpx/routing ###

###> smartgpx/extension ###
# Not a secret — a Chrome extension ID is public. Placeholder until the extension is loaded
# locally (chrome://extensions, Developer mode) or published; see chrome-extension/README.md.
EXTENSION_CHROME_ID=changeme
###< smartgpx/extension ###

###> stripe/stripe-php ###
# Placeholder — real secret key (Stripe Dashboard, test mode) belongs in .env.local, never here.
STRIPE_SECRET_KEY=changeme
###< stripe/stripe-php ###

###> smartgpx/billing ###
# Placeholder — real signing secret (Stripe Dashboard → Webhooks, or `stripe listen` in dev)
# belongs in .env.local, never here.
STRIPE_WEBHOOK_SECRET=changeme
###< smartgpx/billing ###
