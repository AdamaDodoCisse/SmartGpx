{% import '_macros/icons.html.twig' as icons %}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {# Bloquant, avant tout CSS : pose data-theme depuis le choix explicite mémorisé pour
           éviter un flash du mauvais thème au premier rendu. Rien à poser si l'utilisateur n'a
           jamais cliqué sur le bouton — la préférence système (media query) fait déjà le travail
           par défaut, voir app.css. #}
        <script>
            (function () {
                var stored = localStorage.getItem('theme');
                if ('light' === stored || 'dark' === stored) {
                    document.documentElement.dataset.theme = stored;
                }
            })();
        </script>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Fjalla+One&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
        <title>{% block title %}SmartGPX{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}{{ 'layout.default_meta_description'|trans }}{% endblock %}">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="SmartGPX">
        <meta property="og:title" content="{% block og_title %}SmartGPX{% endblock %}">
        <meta property="og:description" content="{% block og_description %}{{ 'layout.default_meta_description'|trans }}{% endblock %}">
        <meta property="og:url" content="{{ app.request.uri }}">
        <meta name="twitter:card" content="summary">
        <meta name="twitter:title" content="{{ block('og_title') }}">
        <meta name="twitter:description" content="{{ block('og_description') }}">
        {# _canonical_route n'existe que pour les routes i18n enregistrées via le raccourci
           #[Route(['en' => ..., 'fr' => ...])] — les routes internes non localisées (ex.
           /admin/*, un seul chemin, jamais de pendant .fr) n'ont pas d'alternative de langue,
           donc pas de balise hreflang à émettre pour elles. #}
        {% set canonical_route = app.request.attributes.get('_canonical_route') %}
        {% if canonical_route %}
            {% set route_params = app.request.attributes.get('_route_params', {}) %}
            <link rel="canonical" href="{{ url(canonical_route, route_params) }}">
            <link rel="alternate" hreflang="en" href="{{ url(canonical_route, route_params|merge({_locale: 'en'})) }}">
            <link rel="alternate" hreflang="fr" href="{{ url(canonical_route, route_params|merge({_locale: 'fr'})) }}">
            <link rel="alternate" hreflang="x-default" href="{{ url(canonical_route, route_params|merge({_locale: 'en'})) }}">
        {% endif %}
        {% block stylesheets %}
            {{ vite_entry_link_tags('app') }}
        {% endblock %}
        {% block javascripts %}{% endblock %}
    </head>
    <body class="min-h-screen bg-background text-foreground antialiased">
        <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground">
            {{ 'layout.skip_to_content'|trans }}
        </a>

        <header class="border-b border-border">
            <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
                <a href="{{ path('app_home') }}" class="font-display text-xl tracking-wide">SmartGPX</a>

                <nav class="hidden items-center gap-6 lg:flex" aria-label="{{ 'layout.main_navigation'|trans }}">
                    <a href="{{ path('app_home') }}#convert" class="text-sm font-medium text-muted-foreground hover:text-foreground">{{ 'layout.nav.convert'|trans }}</a>

                    {# Menu "Tools" en HTML natif (details/summary) : le header reste du Twig
                       statique et indexable (voir ADR-004), aucun JS n'est nécessaire pour un
                       simple menu déroulant. #}
                    <details class="group relative">
                        <summary class="flex cursor-pointer list-none items-center gap-1 text-sm font-medium text-muted-foreground marker:content-none hover:text-foreground [&::-webkit-details-marker]:hidden">
                            {{ 'layout.nav.tools'|trans }}
                            {{ icons.icon('chevron-down', 'size-3.5 transition-transform group-open:rotate-180') }}
                        </summary>
                        <div class="absolute left-1/2 top-full z-20 mt-3 w-56 -translate-x-1/2 rounded-md border border-border bg-background p-2 shadow-lg">
                            <a href="{{ path('app_gpx_viewer') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'home.free_tools.gpx_viewer'|trans }}</a>
                            <a href="{{ path('app_tools_gpx_to_google_maps') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'home.free_tools.gpx_to_google_maps'|trans }}</a>
                            <a href="{{ path('app_tools_gpx_simplify') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'home.free_tools.gpx_simplify'|trans }}</a>
                            <a href="{{ path('app_tools_gpx_merge') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'home.free_tools.gpx_merge'|trans }}</a>
                            <a href="{{ path('app_tools_kml_to_gpx') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'home.free_tools.kml_to_gpx'|trans }}</a>
                            <a href="{{ path('app_tools_kmz_to_gpx') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'home.free_tools.kmz_to_gpx'|trans }}</a>
                            <a href="{{ path('app_tools_tcx_to_gpx') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'home.free_tools.tcx_to_gpx'|trans }}</a>
                            <a href="{{ path('app_tools_fit_to_gpx') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'home.free_tools.fit_to_gpx'|trans }}</a>
                            <a href="{{ path('app_tools_geojson_to_gpx') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'home.free_tools.geojson_to_gpx'|trans }}</a>
                        </div>
                    </details>

                    <a href="{{ path('app_guides_index') }}" class="text-sm font-medium text-muted-foreground hover:text-foreground">{{ 'layout.nav.guides'|trans }}</a>
                    <a href="{{ path('app_pricing') }}" class="text-sm font-medium text-muted-foreground hover:text-foreground">{{ 'layout.nav.pricing'|trans }}</a>
                    <a href="{{ path('app_home') }}#chrome-extension" class="text-sm font-medium text-muted-foreground hover:text-foreground">{{ 'layout.nav.chrome_extension'|trans }}</a>
                    <a href="{{ path('app_login') }}" class="text-sm font-medium text-muted-foreground hover:text-foreground">{{ 'layout.nav.login'|trans }}</a>
                    <a
                        href="{{ path('app_home') }}#convert"
                        class="inline-flex h-9 items-center justify-center whitespace-nowrap rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:opacity-90"
                    >
                        {{ 'layout.nav.convert_cta'|trans }}
                    </a>
                </nav>

                <div class="flex items-center gap-2">
                    <button
                        type="button"
                        data-theme-toggle
                        aria-label="{{ 'layout.nav.toggle_theme'|trans }}"
                        class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                    >
                        <span class="icon-sun">{{ icons.icon('sun', 'size-5') }}</span>
                        <span class="icon-moon">{{ icons.icon('moon', 'size-5') }}</span>
                    </button>
                    <div id="nav-mobile-menu-root" data-locale="{{ app.request.locale }}"></div>
                </div>
            </div>
        </header>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                {% set flash_classes = {
                    success: 'border-[var(--success-border)] bg-[var(--success-bg)] text-[var(--success-fg)]',
                    error: 'border-[var(--error-border)] bg-[var(--error-bg)] text-[var(--error-fg)]',
                } %}
                <div class="mx-auto max-w-6xl px-4 pt-4">
                    <p role="alert" class="flash flash-{{ label }} rounded-md border px-4 py-3 text-sm {{ flash_classes[label]|default('border-border bg-muted text-foreground') }}">
                        {{ message|trans }}
                    </p>
                </div>
            {% endfor %}
        {% endfor %}

        <main id="main-content">
            {% block body %}{% endblock %}
        </main>

        <footer class="mt-16 border-t border-border">
            <div class="mx-auto max-w-6xl px-4 py-12">
                <div class="grid grid-cols-2 gap-8 text-sm sm:grid-cols-4">
                    <div>
                        <p class="font-mono text-xs tracking-wide text-muted-foreground">{{ 'layout.footer.product_heading'|trans }}</p>
                        <ul class="mt-3 space-y-2">
                            <li><a href="{{ path('app_home') }}#convert" class="text-muted-foreground hover:text-foreground">{{ 'layout.footer.google_maps_to_gpx'|trans }}</a></li>
                            <li><a href="{{ path('app_gpx_viewer') }}" class="text-muted-foreground hover:text-foreground">{{ 'home.free_tools.gpx_viewer'|trans }}</a></li>
                            <li><a href="{{ path('app_home') }}#chrome-extension" class="text-muted-foreground hover:text-foreground">{{ 'layout.nav.chrome_extension'|trans }}</a></li>
                            <li><a href="{{ path('app_pricing') }}" class="text-muted-foreground hover:text-foreground">{{ 'layout.nav.pricing'|trans }}</a></li>
                        </ul>
                    </div>
                    <div>
                        <p class="font-mono text-xs tracking-wide text-muted-foreground">{{ 'layout.footer.tools_heading'|trans }}</p>
                        <ul class="mt-3 space-y-2">
                            <li><a href="{{ path('app_tools_gpx_to_google_maps') }}" class="text-muted-foreground hover:text-foreground">{{ 'home.free_tools.gpx_to_google_maps'|trans }}</a></li>
                            <li><a href="{{ path('app_tools_gpx_simplify') }}" class="text-muted-foreground hover:text-foreground">{{ 'home.free_tools.gpx_simplify'|trans }}</a></li>
                            <li><a href="{{ path('app_tools_gpx_merge') }}" class="text-muted-foreground hover:text-foreground">{{ 'home.free_tools.gpx_merge'|trans }}</a></li>
                            <li><a href="{{ path('app_tools_kml_to_gpx') }}" class="text-muted-foreground hover:text-foreground">{{ 'home.free_tools.kml_to_gpx'|trans }}</a></li>
                            <li><a href="{{ path('app_tools_fit_to_gpx') }}" class="text-muted-foreground hover:text-foreground">{{ 'home.free_tools.fit_to_gpx'|trans }}</a></li>
                        </ul>
                    </div>
                    <div>
                        <p class="font-mono text-xs tracking-wide text-muted-foreground">{{ 'layout.footer.resources_heading'|trans }}</p>
                        <ul class="mt-3 space-y-2">
                            <li><a href="{{ path('app_guides_index') }}" class="text-muted-foreground hover:text-foreground">{{ 'layout.nav.guides'|trans }}</a></li>
                            <li><a href="{{ path('app_home') }}#faq" class="text-muted-foreground hover:text-foreground">{{ 'layout.footer.faq'|trans }}</a></li>
                        </ul>
                    </div>
                    <div>
                        <p class="font-mono text-xs tracking-wide text-muted-foreground">{{ 'layout.footer.company_heading'|trans }}</p>
                        <ul class="mt-3 space-y-2">
                            <li><a href="{{ path('app_privacy') }}" class="text-muted-foreground hover:text-foreground">{{ 'layout.footer.privacy'|trans }}</a></li>
                            <li><a href="{{ path('app_terms') }}" class="text-muted-foreground hover:text-foreground">{{ 'layout.footer.terms'|trans }}</a></li>
                        </ul>
                    </div>
                </div>

                <p class="mt-10 border-t border-border pt-6 font-display text-sm tracking-wide text-muted-foreground">
                    &copy; {{ "now"|date("Y") }} SmartGPX
                </p>
            </div>
        </footer>

        {{ vite_entry_script_tags('nav', { dependency: 'react' }) }}

        <script>
            document.querySelector('[data-theme-toggle]').addEventListener('click', function () {
                var systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                var current = document.documentElement.dataset.theme;
                var effectiveIsDark = current ? 'dark' === current : systemPrefersDark;
                var next = effectiveIsDark ? 'light' : 'dark';

                document.documentElement.dataset.theme = next;
                localStorage.setItem('theme', next);
            });
        </script>
    </body>
</html>
