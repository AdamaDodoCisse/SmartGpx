{% import '_macros/icons.html.twig' as icons %}
{% import '_macros/logo.html.twig' as logo %}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" type="image/svg+xml" href="/favicon.svg">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
        <link rel="apple-touch-icon" href="/apple-touch-icon.png">
        {# Bloquant, avant tout CSS : pose data-theme depuis le choix explicite mémorisé pour
           éviter un flash du mauvais thème au premier rendu. Rien à poser si l'utilisateur n'a
           jamais cliqué sur le bouton — la préférence système (media query) fait déjà le travail
           par défaut, voir app.css. #}
        <script>
            (function () {
                var stored = localStorage.getItem('theme');
                if ('light' === stored || 'dark' === stored) {
                    document.documentElement.dataset.theme = stored;
                }
            })();
        </script>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Fjalla+One&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
        <title>{% block title %}SmartGPX{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}{{ 'layout.default_meta_description'|trans }}{% endblock %}">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="SmartGPX">
        <meta property="og:title" content="{% block og_title %}SmartGPX{% endblock %}">
        <meta property="og:description" content="{% block og_description %}{{ 'layout.default_meta_description'|trans }}{% endblock %}">
        <meta property="og:url" content="{{ app.request.uri }}">
        <meta name="twitter:card" content="summary">
        <meta name="twitter:title" content="{{ block('og_title') }}">
        <meta name="twitter:description" content="{{ block('og_description') }}">
        {# Une route i18n enregistrée via le raccourci #[Route(['en' => ..., 'fr' => ...])] porte
           toujours un défaut `_locale` (contrairement aux routes internes non localisées comme
           /admin/*) — c'est ce qui distingue les deux plutôt qu'un `_canonical_route` qui n'est
           en réalité jamais exposé comme attribut de requête. `_route` est déjà le nom canonique
           (sans suffixe .en/.fr) pour ces routes. #}
        {% set canonical_route = app.request.attributes.get('_route') %}
        {% if canonical_route and app.request.attributes.get('_locale') %}
            {% set route_params = app.request.attributes.get('_route_params', {}) %}
            <link rel="canonical" href="{{ url(canonical_route, route_params) }}">
            <link rel="alternate" hreflang="en" href="{{ url(canonical_route, route_params|merge({_locale: 'en'})) }}">
            <link rel="alternate" hreflang="fr" href="{{ url(canonical_route, route_params|merge({_locale: 'fr'})) }}">
            <link rel="alternate" hreflang="x-default" href="{{ url(canonical_route, route_params|merge({_locale: 'en'})) }}">
        {% endif %}
        {% block stylesheets %}
            {{ vite_entry_link_tags('app') }}
        {% endblock %}
        {% block javascripts %}{% endblock %}
    </head>
    <body class="min-h-screen bg-background text-foreground antialiased">
        <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground">
            {{ 'layout.skip_to_content'|trans }}
        </a>

        <header class="border-b border-border">
            <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
                <a href="{{ path('app_home') }}" class="flex items-center gap-2 font-display text-xl tracking-wide">
                    {{ logo.mark('size-7 rounded-md') }}
                    SmartGPX
                </a>

                <nav class="hidden items-center gap-6 lg:flex" aria-label="{{ 'layout.main_navigation'|trans }}">
                    {# Menu "Tools" en HTML natif (details/summary) : le header reste du Twig
                       statique et indexable (voir ADR-004), aucun JS n'est nécessaire pour un
                       simple menu déroulant. Le lien "Convert" autonome a été retiré (redondant
                       avec le bouton CTA "Convert a route" plus bas, même destination) et
                       "Chrome Extension" a rejoint ce menu (autre façon d'accéder au
                       convertisseur) pour raccourcir la barre — retour UX du 15/08. #}
                    <details class="group relative">
                        <summary class="flex cursor-pointer list-none items-center gap-1 text-sm font-medium text-muted-foreground marker:content-none hover:text-foreground [&::-webkit-details-marker]:hidden">
                            {{ 'layout.nav.tools'|trans }}
                            {{ icons.icon('chevron-down', 'size-3.5 transition-transform group-open:rotate-180') }}
                        </summary>
                        <div class="absolute left-1/2 top-full z-20 mt-3 w-56 -translate-x-1/2 rounded-md border border-border bg-background p-2 shadow-lg">
                            <a href="{{ path('app_gpx_viewer') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'home.free_tools.gpx_viewer'|trans }}</a>
                            <a href="{{ path('app_tools_gpx_to_google_maps') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'home.free_tools.gpx_to_google_maps'|trans }}</a>
                            <a href="{{ path('app_tools_gpx_simplify') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'home.free_tools.gpx_simplify'|trans }}</a>
                            <a href="{{ path('app_tools_gpx_merge') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'home.free_tools.gpx_merge'|trans }}</a>
                            <a href="{{ path('app_tools_kml_to_gpx') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'home.free_tools.kml_to_gpx'|trans }}</a>
                            <a href="{{ path('app_tools_kmz_to_gpx') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'home.free_tools.kmz_to_gpx'|trans }}</a>
                            <a href="{{ path('app_tools_tcx_to_gpx') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'home.free_tools.tcx_to_gpx'|trans }}</a>
                            <a href="{{ path('app_tools_fit_to_gpx') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'home.free_tools.fit_to_gpx'|trans }}</a>
                            <a href="{{ path('app_tools_geojson_to_gpx') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'home.free_tools.geojson_to_gpx'|trans }}</a>
                            <div class="my-2 border-t border-border"></div>
                            <a href="{{ path('app_home') }}#chrome-extension" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'layout.nav.chrome_extension'|trans }}</a>
                        </div>
                    </details>

                    <a href="{{ path('app_guides_index') }}" class="nav-link text-sm font-medium text-muted-foreground hover:text-foreground">{{ 'layout.nav.guides'|trans }}</a>
                    <a href="{{ path('app_pricing') }}" class="nav-link text-sm font-medium text-muted-foreground hover:text-foreground">{{ 'layout.nav.pricing'|trans }}</a>

                    {% if app.user %}
                        <details class="group relative">
                            <summary class="flex cursor-pointer list-none items-center gap-1 text-sm font-medium text-muted-foreground marker:content-none hover:text-foreground [&::-webkit-details-marker]:hidden">
                                {{ 'layout.nav.account'|trans }}
                                {{ icons.icon('chevron-down', 'size-3.5 transition-transform group-open:rotate-180') }}
                            </summary>
                            <div class="absolute right-0 top-full z-20 mt-3 w-48 rounded-md border border-border bg-background p-2 shadow-lg">
                                <a href="{{ path('app_account_credits') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'layout.nav.credits'|trans }}</a>
                                <a href="{{ path('app_account_extensions_index') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'layout.nav.extensions'|trans }}</a>
                                <a href="{{ path('app_logout') }}" class="block rounded-sm px-3 py-2 text-sm hover:bg-secondary">{{ 'layout.nav.logout'|trans }}</a>
                            </div>
                        </details>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="nav-link text-sm font-medium text-muted-foreground hover:text-foreground">{{ 'layout.nav.login'|trans }}</a>
                        <a
                            href="{{ path('app_register') }}"
                            class="inline-flex h-9 items-center justify-center whitespace-nowrap rounded-md border border-primary px-4 text-sm font-medium text-primary hover:bg-primary/10"
                        >
                            {{ 'layout.nav.signup'|trans }}
                        </a>
                    {% endif %}

                    <a
                        href="{{ path('app_home') }}#convert"
                        class="inline-flex h-9 items-center justify-center whitespace-nowrap rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:opacity-90"
                    >
                        {{ 'layout.nav.convert_cta'|trans }}
                    </a>
                </nav>

                <div class="flex items-center gap-2">
                    {# Sélecteur de langue : deux liens simples (pas de JS, pas de dropdown),
                       toujours visible dans le bandeau — donc dispensable dans le menu mobile,
                       qui reste inchangé — réutilise le même calcul d'URL par locale que les
                       balises hreflang du <head> ci-dessus. #}
                    {% if canonical_route and app.request.attributes.get('_locale') %}
                        {% set lang_route_params = app.request.attributes.get('_route_params', {}) %}
                        {# Préserve la query string courante (ex. ?session_id=... sur la page de
                           succès Stripe) : url() ne reconstruit que les paramètres de route, donc
                           sans ça, changer de langue perdait silencieusement tout paramètre de
                           requête — retour trouvé en travaillant sur le tracking GTM. #}
                        {% set current_query_string = app.request.queryString %}
                        <div class="flex items-center rounded-md border border-border p-0.5 font-mono text-xs" role="group" aria-label="{{ 'layout.nav.language'|trans }}">
                            {% for locale_code in ['en', 'fr'] %}
                                {% set is_current_locale = app.request.locale == locale_code %}
                                <a
                                    href="{{ url(canonical_route, lang_route_params|merge({_locale: locale_code})) }}{{ current_query_string ? '?' ~ current_query_string : '' }}"
                                    hreflang="{{ locale_code }}"
                                    {% if is_current_locale %}aria-current="true"{% endif %}
                                    class="rounded px-2 py-1 uppercase transition-colors {{ is_current_locale ? 'bg-secondary text-foreground font-semibold' : 'text-muted-foreground hover:text-foreground' }}"
                                >{{ locale_code }}</a>
                            {% endfor %}
                        </div>
                    {% endif %}
                    <button
                        type="button"
                        data-theme-toggle
                        aria-label="{{ 'layout.nav.toggle_theme'|trans }}"
                        class="inline-flex size-11 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-secondary hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                    >
                        <span class="icon-sun">{{ icons.icon('sun', 'size-5') }}</span>
                        <span class="icon-moon">{{ icons.icon('moon', 'size-5') }}</span>
                    </button>
                    {# Les liens sont calculés ici plutôt que codés en dur côté React : path()
                       connaît déjà la bonne URL par locale (slugs traduits inclus, ex.
                       /fr/outils/simplifier-gpx), pas besoin d'une deuxième source de vérité
                       dans MobileMenu.tsx. #}
                    {% set mobile_nav_tools = [
                        { href: path('app_gpx_viewer'), label: 'home.free_tools.gpx_viewer'|trans },
                        { href: path('app_tools_gpx_to_google_maps'), label: 'home.free_tools.gpx_to_google_maps'|trans },
                        { href: path('app_tools_gpx_simplify'), label: 'home.free_tools.gpx_simplify'|trans },
                        { href: path('app_tools_gpx_merge'), label: 'home.free_tools.gpx_merge'|trans },
                        { href: path('app_tools_kml_to_gpx'), label: 'home.free_tools.kml_to_gpx'|trans },
                        { href: path('app_tools_kmz_to_gpx'), label: 'home.free_tools.kmz_to_gpx'|trans },
                        { href: path('app_tools_tcx_to_gpx'), label: 'home.free_tools.tcx_to_gpx'|trans },
                        { href: path('app_tools_fit_to_gpx'), label: 'home.free_tools.fit_to_gpx'|trans },
                        { href: path('app_tools_geojson_to_gpx'), label: 'home.free_tools.geojson_to_gpx'|trans },
                    ] %}
                    <div
                        id="nav-mobile-menu-root"
                        data-convert-href="{{ path('app_home') }}#convert"
                        data-tools="{{ mobile_nav_tools|json_encode }}"
                        data-guides-href="{{ path('app_guides_index') }}"
                        data-pricing-href="{{ path('app_pricing') }}"
                        data-chrome-extension-href="{{ path('app_home') }}#chrome-extension"
                        data-is-authenticated="{{ app.user ? '1' : '' }}"
                        data-login-href="{{ path('app_login') }}"
                        data-signup-href="{{ path('app_register') }}"
                        data-credits-href="{{ path('app_account_credits') }}"
                        data-extensions-href="{{ path('app_account_extensions_index') }}"
                        data-logout-href="{{ path('app_logout') }}"
                    ></div>
                </div>
            </div>
        </header>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                {% set flash_classes = {
                    success: 'border-[var(--success-border)] bg-[var(--success-bg)] text-[var(--success-fg)]',
                    error: 'border-[var(--error-border)] bg-[var(--error-bg)] text-[var(--error-fg)]',
                } %}
                <div class="mx-auto max-w-6xl px-4 pt-4">
                    <p role="alert" class="flash flash-{{ label }} rounded-md border px-4 py-3 text-sm {{ flash_classes[label]|default('border-border bg-muted text-foreground') }}">
                        {{ message|trans }}
                    </p>
                </div>
            {% endfor %}
        {% endfor %}

        <main id="main-content">
            {% block body %}{% endblock %}
        </main>

        <footer class="contour-bg relative mt-16 border-t border-border">
            <div class="absolute inset-x-0 top-0 h-px bg-route" aria-hidden="true"></div>
            <div class="relative mx-auto max-w-6xl px-4 py-12">
                <div class="grid grid-cols-2 gap-8 text-sm sm:grid-cols-4">
                    <div>
                        <p class="font-mono text-xs tracking-wide text-muted-foreground">{{ 'layout.footer.product_heading'|trans }}</p>
                        <ul class="mt-3 space-y-2">
                            <li><a href="{{ path('app_home') }}#convert" class="nav-link text-muted-foreground hover:text-foreground">{{ 'layout.footer.google_maps_to_gpx'|trans }}</a></li>
                            <li><a href="{{ path('app_gpx_viewer') }}" class="nav-link text-muted-foreground hover:text-foreground">{{ 'home.free_tools.gpx_viewer'|trans }}</a></li>
                            <li><a href="{{ path('app_home') }}#chrome-extension" class="nav-link text-muted-foreground hover:text-foreground">{{ 'layout.nav.chrome_extension'|trans }}</a></li>
                            <li><a href="{{ path('app_pricing') }}" class="nav-link text-muted-foreground hover:text-foreground">{{ 'layout.nav.pricing'|trans }}</a></li>
                        </ul>
                    </div>
                    <div>
                        <p class="font-mono text-xs tracking-wide text-muted-foreground">{{ 'layout.footer.tools_heading'|trans }}</p>
                        <ul class="mt-3 space-y-2">
                            <li><a href="{{ path('app_tools_gpx_to_google_maps') }}" class="nav-link text-muted-foreground hover:text-foreground">{{ 'home.free_tools.gpx_to_google_maps'|trans }}</a></li>
                            <li><a href="{{ path('app_tools_gpx_simplify') }}" class="nav-link text-muted-foreground hover:text-foreground">{{ 'home.free_tools.gpx_simplify'|trans }}</a></li>
                            <li><a href="{{ path('app_tools_gpx_merge') }}" class="nav-link text-muted-foreground hover:text-foreground">{{ 'home.free_tools.gpx_merge'|trans }}</a></li>
                            <li><a href="{{ path('app_tools_kml_to_gpx') }}" class="nav-link text-muted-foreground hover:text-foreground">{{ 'home.free_tools.kml_to_gpx'|trans }}</a></li>
                            <li><a href="{{ path('app_tools_fit_to_gpx') }}" class="nav-link text-muted-foreground hover:text-foreground">{{ 'home.free_tools.fit_to_gpx'|trans }}</a></li>
                        </ul>
                    </div>
                    <div>
                        <p class="font-mono text-xs tracking-wide text-muted-foreground">{{ 'layout.footer.resources_heading'|trans }}</p>
                        <ul class="mt-3 space-y-2">
                            <li><a href="{{ path('app_guides_index') }}" class="nav-link text-muted-foreground hover:text-foreground">{{ 'layout.nav.guides'|trans }}</a></li>
                            <li><a href="{{ path('app_home') }}#faq" class="nav-link text-muted-foreground hover:text-foreground">{{ 'layout.footer.faq'|trans }}</a></li>
                        </ul>
                    </div>
                    <div>
                        <p class="font-mono text-xs tracking-wide text-muted-foreground">{{ 'layout.footer.company_heading'|trans }}</p>
                        <ul class="mt-3 space-y-2">
                            <li><a href="{{ path('app_privacy') }}" class="nav-link text-muted-foreground hover:text-foreground">{{ 'layout.footer.privacy'|trans }}</a></li>
                            <li><a href="{{ path('app_terms') }}" class="nav-link text-muted-foreground hover:text-foreground">{{ 'layout.footer.terms'|trans }}</a></li>
                            <li><a href="{{ path('app_contact') }}" class="nav-link text-muted-foreground hover:text-foreground">{{ 'layout.footer.contact'|trans }}</a></li>
                        </ul>
                    </div>
                </div>

                <div class="mt-10 flex items-center justify-between border-t border-border pt-6">
                    <a href="{{ path('app_home') }}" class="flex items-center gap-2 font-display text-sm tracking-wide text-muted-foreground hover:text-foreground">
                        {{ logo.mark('size-5 rounded') }}
                        SmartGPX
                    </a>
                    <p class="font-mono text-xs text-muted-foreground">&copy; {{ "now"|date("Y") }}</p>
                </div>

                <p class="mt-4 flex items-center justify-center gap-1.5 font-mono text-xs text-muted-foreground">
                    {{ 'layout.footer.made_with_love'|trans }}
                    {{ icons.icon('heart', 'size-3.5') }}
                    <a href="https://expert-ecom.com" target="_blank" rel="noopener noreferrer" class="hover:text-foreground">expert-ecom.com</a>
                </p>
            </div>
        </footer>

        {% if gtm_container_id and 'changeme' != gtm_container_id %}
            {# Bandeau de consentement RGPD : le conteneur GTM n'est JAMAIS chargé sans acceptation
               explicite, y compris pour la toute première page vue — voir
               documentation/decisions/ADR-009-analytics-consent.md et
               documentation/technique/google-tag-manager.md. dataLayer.push (voir
               assets/app/src/lib/dataLayer.ts) fonctionne toujours, avec ou sans consentement :
               c'est un tableau local inoffensif tant que ce script ci-dessous n'a rien chargé.
               Pas de <noscript> GTM standard ici, volontairement : sans JS, ce bandeau ne peut de
               toute façon jamais recueillir de consentement. #}
            <div
                id="gtm-consent-banner"
                hidden
                class="fixed inset-x-0 bottom-0 z-50 border-t border-border bg-background px-4 py-4 shadow-lg"
                role="dialog"
                aria-label="{{ 'analytics.consent.title'|trans }}"
            >
                <div class="mx-auto flex max-w-6xl flex-col items-center gap-3 sm:flex-row sm:justify-between">
                    <p class="text-sm text-muted-foreground">{{ 'analytics.consent.body'|trans }}</p>
                    <div class="flex shrink-0 gap-2">
                        <button type="button" data-consent-decline class="rounded-md border border-border px-4 py-2 text-sm font-medium text-muted-foreground hover:bg-secondary">
                            {{ 'analytics.consent.decline'|trans }}
                        </button>
                        <button type="button" data-consent-accept class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:opacity-90">
                            {{ 'analytics.consent.accept'|trans }}
                        </button>
                    </div>
                </div>
            </div>
            <script>
                (function () {
                    var STORAGE_KEY = 'gtm_consent';
                    var containerId = {{ gtm_container_id|json_encode|raw }};

                    function loadGtmContainer() {
                        if (document.getElementById('gtm-container-script')) {
                            return;
                        }
                        var script = document.createElement('script');
                        script.id = 'gtm-container-script';
                        script.async = true;
                        script.src = 'https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(containerId);
                        document.head.appendChild(script);
                    }

                    var stored = localStorage.getItem(STORAGE_KEY);
                    if ('granted' === stored) {
                        loadGtmContainer();
                    } else if ('declined' !== stored) {
                        var banner = document.getElementById('gtm-consent-banner');
                        if (banner) {
                            banner.hidden = false;
                        }
                    }

                    document.addEventListener('click', function (event) {
                        if (event.target.closest('[data-consent-accept]')) {
                            localStorage.setItem(STORAGE_KEY, 'granted');
                            document.getElementById('gtm-consent-banner').hidden = true;
                            loadGtmContainer();
                        } else if (event.target.closest('[data-consent-decline]')) {
                            localStorage.setItem(STORAGE_KEY, 'declined');
                            document.getElementById('gtm-consent-banner').hidden = true;
                        }
                    });
                })();
            </script>
        {% endif %}

        {{ vite_entry_script_tags('nav', { dependency: 'react' }) }}

        <script>
            document.querySelector('[data-theme-toggle]').addEventListener('click', function () {
                var systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                var current = document.documentElement.dataset.theme;
                var effectiveIsDark = current ? 'dark' === current : systemPrefersDark;
                var next = effectiveIsDark ? 'light' : 'dark';

                document.documentElement.dataset.theme = next;
                localStorage.setItem('theme', next);
            });
        </script>

        {# Écouteur délégué unique (pas un par formulaire) : _pack_grid.html.twig est inclus à la
           fois sur /pricing et sur la page d'accueil — voir
           documentation/technique/google-tag-manager.md. dataLayer.push a lieu que le
           consentement GTM soit accordé ou non (tableau local inoffensif tant que rien n'est
           chargé, voir plus haut). Désactive aussi le bouton pour éviter un double clic qui
           créerait deux sessions Stripe Checkout. #}
        <script>
            document.addEventListener('submit', function (event) {
                var form = event.target.closest('[data-begin-checkout]');
                if (!form) {
                    return;
                }

                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({
                    event: 'begin_checkout',
                    currency: form.dataset.currency,
                    value: Number.parseFloat(form.dataset.price),
                    items: [
                        {
                            item_id: form.dataset.packId,
                            item_name: form.dataset.credits + ' SmartGPX Credits',
                            item_category: 'credits',
                            price: Number.parseFloat(form.dataset.price),
                            quantity: 1,
                        },
                    ],
                });

                var submitButton = form.querySelector('button[type="submit"]');
                if (submitButton) {
                    submitButton.disabled = true;
                }
            });
        </script>
    </body>
</html>
