{% import '_macros/icons.html.twig' as icons %}
{# En-tête partagé des 13 pages d'outils gratuits — icône, eyebrow (catégorie), titre, intro et
   bandeau de confiance. Variables attendues : icon (nom d'icône), eyebrow_key (clé de traduction
   déjà catégorielle, ex. 'tools.category.format_converter'), i18n_prefix (ex. 'tools.gpx_simplify',
   pour résoudre .title et .intro), wide (bool, optionnel — largeur élargie pour gpx_viewer). #}
<div class="contour-bg border-b border-border bg-secondary/40">
    <div class="mx-auto px-4 py-12 lg:py-16 {{ wide is defined and wide ? 'max-w-5xl' : 'max-w-3xl' }}">
        <div class="flex size-14 items-center justify-center rounded-full border border-route/30 bg-route/10 text-route">
            {{ icons.icon(icon, 'size-6') }}
        </div>
        <p class="mt-4 font-mono text-xs font-medium tracking-[0.2em] text-route">{{ eyebrow_key|trans }}</p>
        <h1 class="mt-2 font-display text-4xl tracking-tight">{{ (i18n_prefix ~ '.title')|trans }}</h1>
        <p class="mt-3 max-w-xl text-muted-foreground">{{ (i18n_prefix ~ '.intro')|trans }}</p>

        <ul class="mt-6 flex flex-wrap gap-2">
            {% for badge_key in ['tools.trust.browser', 'tools.trust.no_signup', 'tools.trust.free'] %}
                <li class="rounded-full border border-border bg-background px-3 py-1 font-mono text-xs text-muted-foreground">{{ badge_key|trans }}</li>
            {% endfor %}
        </ul>
    </div>
</div>
