{% extends 'base.html.twig' %}

{% block title %}{{ 'tools.gpx_to_geojson.meta_title'|trans }} — SmartGPX{% endblock %}
{% block meta_description %}{{ 'tools.gpx_to_geojson.meta_description'|trans }}{% endblock %}

{% block body %}
    {% include 'tools/_header.html.twig' with {
        icon: 'braces',
        eyebrow_key: 'tools.category.format_converter',
        i18n_prefix: 'tools.gpx_to_geojson',
    } only %}

    <div class="mx-auto max-w-3xl px-4 py-12">
        <div id="gpx-to-geojson-root"></div>

        <div class="prose mt-10">
            {% if app.request.locale == 'fr' %}
                <h2>Pourquoi convertir un GPX en GeoJSON ?</h2>
                <p>Si vous développez avec Mapbox, Leaflet ou une autre bibliothèque cartographique
                web, ces outils attendent du GeoJSON, pas du GPX. Cet outil convertit votre trace
                en une <code>FeatureCollection</code> GeoJSON standard, prête à charger dans
                n'importe quelle carte web.</p>
                <p><a href="{{ path('app_guides_gpx_vs_geojson') }}">GPX vs GeoJSON</a> détaille
                les différences entre les deux formats.</p>
            {% else %}
                <h2>Why convert GPX to GeoJSON?</h2>
                <p>If you're building with Mapbox, Leaflet, or another web mapping library, those
                tools expect GeoJSON, not GPX. This tool converts your track into a standard
                GeoJSON <code>FeatureCollection</code>, ready to load into any web map.</p>
                <p><a href="{{ path('app_guides_gpx_vs_geojson') }}">GPX vs GeoJSON</a> covers the
                differences between the two formats.</p>
            {% endif %}
        </div>

        {% include 'tools/_related.html.twig' with {
            related: [
                { route: 'app_tools_geojson_to_gpx', icon: 'braces', label: 'home.free_tools.geojson_to_gpx' },
                { route: 'app_gpx_viewer', icon: 'map', label: 'home.free_tools.gpx_viewer' },
            ],
        } only %}

        {% include 'tools/_cta.html.twig' with { variant: 'google_maps' } only %}
    </div>
    {{ vite_entry_script_tags('gpxToGeojson', { dependency: 'react' }) }}
{% endblock %}
