{% extends 'base.html.twig' %}

{% block title %}{{ 'tools.geojson_to_gpx.meta_title'|trans }} — SmartGPX{% endblock %}
{% block meta_description %}{{ 'tools.geojson_to_gpx.meta_description'|trans }}{% endblock %}

{% block body %}
    {% include 'tools/_header.html.twig' with {
        icon: 'braces',
        eyebrow_key: 'tools.category.format_converter',
        i18n_prefix: 'tools.geojson_to_gpx',
    } only %}

    <div class="mx-auto max-w-3xl px-4 py-12">
        <div id="geojson-to-gpx-root"></div>

        <div class="prose mt-10">
            {% if app.request.locale == 'fr' %}
                <h2>Pourquoi convertir un GeoJSON en GPX ?</h2>
                <p>Le GeoJSON est le format des développeurs web — utilisé par Mapbox, Leaflet et
                la plupart des outils cartographiques en ligne — plutôt qu'un format pour appareils
                GPS. Si un tracé a été exporté depuis un outil de dessin de carte ou une API en
                GeoJSON et que vous voulez le charger sur un appareil GPS, convertissez-le d'abord
                en GPX ici.</p>
                <p><a href="{{ path('app_guides_gpx_vs_geojson') }}">GPX vs GeoJSON</a> détaille
                les différences entre les deux formats.</p>
            {% else %}
                <h2>Why convert GeoJSON to GPX?</h2>
                <p>GeoJSON is a web developer's format — used by Mapbox, Leaflet, and most online
                mapping tools — rather than a GPS device format. If a track was exported from a
                map-drawing tool or an API as GeoJSON and you want to load it onto a GPS device,
                convert it to GPX here first.</p>
                <p><a href="{{ path('app_guides_gpx_vs_geojson') }}">GPX vs GeoJSON</a> covers the
                differences between the two formats.</p>
            {% endif %}
        </div>

        {% include 'tools/_related.html.twig' with {
            related: [
                { route: 'app_tools_gpx_to_geojson', icon: 'braces', label: 'home.free_tools.gpx_to_geojson' },
                { route: 'app_gpx_viewer', icon: 'map', label: 'home.free_tools.gpx_viewer' },
            ],
        } only %}

        {% include 'tools/_cta.html.twig' with { variant: 'google_maps' } only %}
    </div>
    {{ vite_entry_script_tags('geojsonToGpx', { dependency: 'react' }) }}
{% endblock %}
