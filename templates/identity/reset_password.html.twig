{% extends 'base.html.twig' %}

{% block title %}{{ 'identity.reset_password.title'|trans }} — SmartGPX{% endblock %}

{% block body %}
    <main>
        <h1>{{ 'identity.reset_password.title'|trans }}</h1>

        {{ form_start(resetForm) }}
            {{ form_row(resetForm.plainPassword) }}
            <button type="submit" name="reset_password_submit">{{ 'identity.reset_password.submit'|trans }}</button>
        {{ form_end(resetForm) }}
    </main>
{% endblock %}
