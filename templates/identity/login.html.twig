{% extends 'base.html.twig' %}

{% block title %}{{ 'identity.login.title'|trans }} — SmartGPX{% endblock %}

{% block body %}
    <div class="mx-auto max-w-md px-4 py-12">
        <h1 class="text-3xl font-semibold">{{ 'identity.login.title'|trans }}</h1>

        {% if error %}
            <p role="alert" class="flash flash-error mt-6 rounded-md border border-[var(--error-border)] bg-[var(--error-bg)] px-4 py-3 text-sm text-[var(--error-fg)]">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </p>
        {% endif %}

        <form method="post" class="mt-8">
            <div class="mb-4">
                <label for="inputEmail" class="mb-1.5 block text-sm font-medium">{{ 'identity.form.email'|trans }}</label>
                <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" autocomplete="email" required autofocus
                       class="flex h-10 w-full rounded-md border border-border bg-background px-4 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
            </div>

            <div class="mb-4">
                <label for="inputPassword" class="mb-1.5 block text-sm font-medium">{{ 'identity.form.password'|trans }}</label>
                <input type="password" name="_password" id="inputPassword" autocomplete="current-password" required
                       class="flex h-10 w-full rounded-md border border-border bg-background px-4 py-2 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" name="login_submit" class="inline-flex h-10 w-full items-center justify-center gap-2 whitespace-nowrap rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
                {{ 'identity.login.submit'|trans }}
            </button>
        </form>

        <p class="mt-6 text-center text-sm">
            <a href="{{ path('app_forgot_password_request') }}" class="text-muted-foreground hover:text-foreground">{{ 'identity.login.forgot_password'|trans }}</a>
        </p>
        <p class="mt-2 text-center text-sm text-muted-foreground">
            <a href="{{ path('app_register') }}" class="text-primary hover:underline">{{ 'identity.login.no_account'|trans }}</a>
        </p>
    </div>
{% endblock %}
