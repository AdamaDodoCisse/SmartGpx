{% extends 'base.html.twig' %}

{% block title %}{{ 'identity.forgot_password.title'|trans }} — SmartGPX{% endblock %}

{% block body %}
    <main>
        <h1>{{ 'identity.forgot_password.title'|trans }}</h1>
        <p>{{ 'identity.forgot_password.instructions'|trans }}</p>

        {{ form_start(requestForm) }}
            {{ form_row(requestForm.email) }}
            <button type="submit" name="forgot_password_submit">{{ 'identity.forgot_password.submit'|trans }}</button>
        {{ form_end(requestForm) }}
    </main>
{% endblock %}
