{% extends 'base.html.twig' %}

{% block title %}{{ 'identity.forgot_password.title'|trans }} — SmartGPX{% endblock %}

{% block body %}
    <div class="mx-auto max-w-md px-4 py-12">
        <h1 class="text-3xl font-display tracking-tight">{{ 'identity.forgot_password.title'|trans }}</h1>
        <p class="mt-2 text-muted-foreground">{{ 'identity.forgot_password.instructions'|trans }}</p>

        {{ form_start(requestForm, { attr: { class: 'mt-8' } }) }}
            {{ form_row(requestForm.email) }}
            <button type="submit" name="forgot_password_submit" class="inline-flex h-10 w-full items-center justify-center gap-2 whitespace-nowrap rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
                {{ 'identity.forgot_password.submit'|trans }}
            </button>
        {{ form_end(requestForm) }}
    </div>
{% endblock %}
