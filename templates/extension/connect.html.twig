{% extends 'base.html.twig' %}

{% block title %}{{ 'extension.connect.title'|trans }} — SmartGPX{% endblock %}

{% block body %}
    <div class="mx-auto max-w-xl px-4 py-16 text-center">
        <h1 class="text-2xl font-semibold">{{ 'extension.connect.title'|trans }}</h1>

        <div
            id="extension-connect-root"
            data-token="{{ plainToken }}"
            data-extension-id="{{ extensionChromeId }}"
            data-api-origin="{{ apiOrigin }}"
            class="mt-6"
        ></div>
    </div>

    {{ vite_entry_script_tags('extensionConnect', { dependency: 'react' }) }}
{% endblock %}
