{% extends 'admin/_layout.html.twig' %}
{% import '_macros/icons.html.twig' as icons %}
{% import 'admin/_macros.html.twig' as admin %}
{% block title %}Credit Packs — Admin — SmartGPX{% endblock %}
{% block admin_body %}
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold">Credit Packs</h1>
        <a
            href="{{ path('app_admin_credit_packs_new') }}"
            class="flex h-9 items-center gap-1.5 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:opacity-90"
        >
            {{ icons.icon('package', 'size-4') }}
            New pack
        </a>
    </div>

    <div class="mt-6 overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead>
                <tr class="border-b border-border text-muted-foreground">
                    <th class="whitespace-nowrap py-2 pr-6 font-medium">Credits</th>
                    <th class="whitespace-nowrap py-2 pr-6 font-medium">Price</th>
                    <th class="whitespace-nowrap py-2 pr-6 font-medium">Badge</th>
                    <th class="whitespace-nowrap py-2 pr-6 font-medium">Order</th>
                    <th class="whitespace-nowrap py-2 pr-6 font-medium">Status</th>
                    <th class="whitespace-nowrap py-2 font-medium"></th>
                </tr>
            </thead>
            <tbody>
                {% for pack in packs %}
                    <tr class="border-b border-border">
                        <td class="whitespace-nowrap py-3 pr-6 [font-variant-numeric:tabular-nums]">{{ pack.credits }}</td>
                        <td class="whitespace-nowrap py-3 pr-6 [font-variant-numeric:tabular-nums]">{{ (pack.priceCents / 100)|number_format(2) }} {{ pack.currency|upper }}</td>
                        <td class="whitespace-nowrap py-3 pr-6">{{ pack.badge ? admin.pill(pack.badge.value|replace({'_': ' '}), 'neutral') : '—' }}</td>
                        <td class="whitespace-nowrap py-3 pr-6 [font-variant-numeric:tabular-nums] text-muted-foreground">{{ pack.displayOrder }}</td>
                        <td class="whitespace-nowrap py-3 pr-6">{{ admin.pill(pack.active ? 'Active' : 'Inactive', pack.active ? 'success' : 'neutral') }}</td>
                        <td class="whitespace-nowrap py-3 text-right">
                            <a href="{{ path('app_admin_credit_packs_edit', { publicId: pack.publicId }) }}" class="font-medium hover:underline">Edit</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
