{% extends 'admin/_layout.html.twig' %}
{% block title %}Credit Packs — Admin — SmartGPX{% endblock %}
{% block admin_body %}
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-semibold">Credit Packs</h1>
        <a href="{{ path('app_admin_credit_packs_new') }}" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground">
            New pack
        </a>
    </div>

    <table class="mt-6 w-full text-left text-sm">
        <thead>
            <tr class="border-b border-border text-muted-foreground">
                <th class="py-2 font-medium">Credits</th>
                <th class="py-2 font-medium">Price</th>
                <th class="py-2 font-medium">Badge</th>
                <th class="py-2 font-medium">Order</th>
                <th class="py-2 font-medium">Active</th>
                <th class="py-2 font-medium"></th>
            </tr>
        </thead>
        <tbody>
            {% for pack in packs %}
                <tr class="border-b border-border">
                    <td class="py-3">{{ pack.credits }}</td>
                    <td class="py-3">{{ (pack.priceCents / 100)|number_format(2) }} {{ pack.currency|upper }}</td>
                    <td class="py-3">{{ pack.badge ? pack.badge.value : '—' }}</td>
                    <td class="py-3">{{ pack.displayOrder }}</td>
                    <td class="py-3">{{ pack.active ? 'Yes' : 'No' }}</td>
                    <td class="py-3 text-right">
                        <a href="{{ path('app_admin_credit_packs_edit', { publicId: pack.publicId }) }}" class="hover:underline">Edit</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
