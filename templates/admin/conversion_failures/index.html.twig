{% extends 'admin/_layout.html.twig' %}
{% import '_macros/icons.html.twig' as icons %}
{% import '_macros/pill.html.twig' as pill %}
{% block title %}Failed Conversions — Admin — SmartGPX{% endblock %}
{% block admin_body %}
    <h1 class="text-2xl font-semibold">Failed Conversions</h1>
    {% if result.items is empty %}
        <p class="mt-6 text-sm text-muted-foreground">No failed conversions yet.</p>
    {% else %}
        <div class="mt-6 overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="border-b border-border text-muted-foreground">
                        <th class="whitespace-nowrap py-2 pr-6 font-medium">User</th>
                        <th class="whitespace-nowrap py-2 pr-6 font-medium">URL</th>
                        <th class="whitespace-nowrap py-2 pr-6 font-medium">Reason</th>
                        <th class="whitespace-nowrap py-2 font-medium">Date</th>
                    </tr>
                </thead>
                <tbody>
                    {% for failure in result.items %}
                        <tr class="border-b border-border">
                            <td class="whitespace-nowrap py-3 pr-6">
                                <a href="{{ path('app_admin_users_show', { publicId: failure.user.publicId }) }}" class="font-medium hover:underline">
                                    {{ failure.user.email }}
                                </a>
                            </td>
                            <td class="max-w-xs truncate py-3 pr-6 font-mono text-xs text-muted-foreground" title="{{ failure.sourceUrl }}">{{ failure.sourceUrl }}</td>
                            <td class="whitespace-nowrap py-3 pr-6">{{ pill.pill(failure.reason.value|replace({'_': ' '}), 'error') }}</td>
                            <td class="whitespace-nowrap py-3 text-muted-foreground [font-variant-numeric:tabular-nums]">{{ failure.createdAt|date('Y-m-d H:i') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if result.total > result.perPage %}
        <div class="mt-6 flex items-center gap-4 text-sm">
            <a
                href="{{ result.hasPrevious ? path('app_admin_conversions_failed', { page: result.page - 1 }) : '#' }}"
                class="flex items-center gap-1 rounded-md border border-border px-3 py-1.5 {{ result.hasPrevious ? 'hover:bg-secondary' : 'pointer-events-none opacity-40' }}"
            >
                {{ icons.icon('arrow-left', 'size-3.5') }}
                Previous
            </a>
            <span class="text-muted-foreground">Page {{ result.page }} of {{ result.lastPage }}</span>
            <a
                href="{{ result.hasNext ? path('app_admin_conversions_failed', { page: result.page + 1 }) : '#' }}"
                class="flex items-center gap-1 rounded-md border border-border px-3 py-1.5 {{ result.hasNext ? 'hover:bg-secondary' : 'pointer-events-none opacity-40' }}"
            >
                Next
                {{ icons.icon('arrow-right', 'size-3.5') }}
            </a>
        </div>
    {% endif %}
{% endblock %}
