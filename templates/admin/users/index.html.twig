{% extends 'admin/_layout.html.twig' %}
{% block title %}Users — Admin — SmartGPX{% endblock %}
{% block admin_body %}
    <h1 class="text-2xl font-semibold">Users</h1>
    <table class="mt-6 w-full text-left text-sm">
        <thead>
            <tr class="border-b border-border text-muted-foreground">
                <th class="py-2 font-medium">Email</th>
                <th class="py-2 font-medium">Roles</th>
                <th class="py-2 font-medium">Verified</th>
                <th class="py-2 font-medium">Registered</th>
            </tr>
        </thead>
        <tbody>
            {% for targetUser in result.items %}
                <tr class="border-b border-border">
                    <td class="py-3">
                        <a href="{{ path('app_admin_users_show', { publicId: targetUser.publicId }) }}" class="hover:underline">
                            {{ targetUser.email }}
                        </a>
                    </td>
                    <td class="py-3">{{ targetUser.roles|join(', ') }}</td>
                    <td class="py-3">{{ targetUser.verified ? 'Yes' : 'No' }}</td>
                    <td class="py-3">{{ targetUser.createdAt|date('Y-m-d') }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if result.total > result.perPage %}
        <div class="mt-6 flex items-center gap-4 text-sm">
            {% if result.hasPrevious %}
                <a href="{{ path('app_admin_users_index', { page: result.page - 1 }) }}">&larr; Previous</a>
            {% endif %}
            <span>Page {{ result.page }} of {{ result.lastPage }}</span>
            {% if result.hasNext %}
                <a href="{{ path('app_admin_users_index', { page: result.page + 1 }) }}">Next &rarr;</a>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
