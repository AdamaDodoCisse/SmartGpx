{% extends 'admin/_layout.html.twig' %}
{% import '_macros/icons.html.twig' as icons %}
{% import 'admin/_macros.html.twig' as admin %}
{% block title %}Users — Admin — SmartGPX{% endblock %}
{% block admin_body %}
    <h1 class="text-2xl font-semibold">Users</h1>
    <table class="mt-6 w-full text-left text-sm">
        <thead>
            <tr class="border-b border-border text-muted-foreground">
                <th class="py-2 font-medium">Email</th>
                <th class="py-2 font-medium">Roles</th>
                <th class="py-2 font-medium">Verified</th>
                <th class="py-2 font-medium">Registered</th>
            </tr>
        </thead>
        <tbody>
            {% for targetUser in result.items %}
                <tr class="border-b border-border">
                    <td class="py-3">
                        <a href="{{ path('app_admin_users_show', { publicId: targetUser.publicId }) }}" class="font-medium hover:underline">
                            {{ targetUser.email }}
                        </a>
                    </td>
                    <td class="py-3 text-muted-foreground">{{ targetUser.roles|join(', ') }}</td>
                    <td class="py-3">{{ admin.pill(targetUser.verified ? 'Verified' : 'Unverified', targetUser.verified ? 'success' : 'neutral') }}</td>
                    <td class="py-3 text-muted-foreground [font-variant-numeric:tabular-nums]">{{ targetUser.createdAt|date('Y-m-d') }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if result.total > result.perPage %}
        <div class="mt-6 flex items-center gap-4 text-sm">
            <a
                href="{{ result.hasPrevious ? path('app_admin_users_index', { page: result.page - 1 }) : '#' }}"
                class="flex items-center gap-1 rounded-md border border-border px-3 py-1.5 {{ result.hasPrevious ? 'hover:bg-secondary' : 'pointer-events-none opacity-40' }}"
            >
                {{ icons.icon('arrow-left', 'size-3.5') }}
                Previous
            </a>
            <span class="text-muted-foreground">Page {{ result.page }} of {{ result.lastPage }}</span>
            <a
                href="{{ result.hasNext ? path('app_admin_users_index', { page: result.page + 1 }) : '#' }}"
                class="flex items-center gap-1 rounded-md border border-border px-3 py-1.5 {{ result.hasNext ? 'hover:bg-secondary' : 'pointer-events-none opacity-40' }}"
            >
                Next
                {{ icons.icon('arrow-right', 'size-3.5') }}
            </a>
        </div>
    {% endif %}
{% endblock %}
