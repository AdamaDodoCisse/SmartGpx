{% extends 'admin/_layout.html.twig' %}
{% import '_macros/icons.html.twig' as icons %}
{% import 'admin/_macros.html.twig' as admin %}
{% block title %}{{ targetUser.email }} — Admin — SmartGPX{% endblock %}
{% block admin_body %}
    <a href="{{ path('app_admin_users_index') }}" class="flex w-fit items-center gap-1 text-sm text-muted-foreground hover:text-foreground">
        {{ icons.icon('arrow-left', 'size-3.5') }}
        Users
    </a>
    <div class="mt-2 flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-semibold">{{ targetUser.email }}</h1>
        {{ admin.pill(targetUser.verified ? 'Verified' : 'Unverified', targetUser.verified ? 'success' : 'neutral') }}
    </div>

    <dl class="mt-6 grid grid-cols-2 gap-4 text-sm sm:grid-cols-4">
        <div class="rounded-md border border-border p-4">
            <dt class="text-muted-foreground">Roles</dt>
            <dd class="mt-1 font-medium">{{ targetUser.roles|join(', ') }}</dd>
        </div>
        <div class="rounded-md border border-border p-4">
            <dt class="text-muted-foreground">Registered</dt>
            <dd class="mt-1 font-medium [font-variant-numeric:tabular-nums]">{{ targetUser.createdAt|date('Y-m-d') }}</dd>
        </div>
        <div class="rounded-md border border-border p-4">
            <dt class="text-muted-foreground">Balance</dt>
            <dd class="mt-1 font-medium [font-variant-numeric:tabular-nums]">{{ creditAccount ? creditAccount.balance : '—' }}</dd>
        </div>
    </dl>

    <h2 class="mt-10 text-lg font-semibold">Grant credits</h2>
    {{ form_start(creditAdjustmentForm, { action: path('app_admin_users_credit_adjustment', { publicId: targetUser.publicId }), method: 'POST' }) }}
        <div class="mt-3 flex items-end gap-3">
            {{ form_row(creditAdjustmentForm.amount) }}
            <button type="submit" class="flex h-10 items-center gap-1.5 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:opacity-90">
                {{ icons.icon('infinity', 'size-4') }}
                Grant
            </button>
        </div>
    {{ form_end(creditAdjustmentForm) }}

    <h2 class="mt-10 text-lg font-semibold">Credit ledger</h2>
    {% if ledger is null or ledger.items is empty %}
        <p class="mt-2 text-sm text-muted-foreground">No credit account or no transactions yet.</p>
    {% else %}
        <table class="mt-4 w-full text-left text-sm">
            <thead>
                <tr class="border-b border-border text-muted-foreground">
                    <th class="py-2 font-medium">Type</th>
                    <th class="py-2 font-medium">Amount</th>
                    <th class="py-2 font-medium">Balance after</th>
                    <th class="py-2 font-medium">Date</th>
                </tr>
            </thead>
            <tbody>
                {% for transaction in ledger.items %}
                    <tr class="border-b border-border">
                        <td class="py-3">{{ admin.pill(transaction.type.value|replace({'_': ' '}), transaction.amount > 0 ? 'success' : 'neutral') }}</td>
                        <td class="py-3 [font-variant-numeric:tabular-nums] {{ transaction.amount > 0 ? 'text-[var(--success-fg)]' : '' }}">
                            {{ transaction.amount > 0 ? '+' ~ transaction.amount : transaction.amount }}
                        </td>
                        <td class="py-3 [font-variant-numeric:tabular-nums]">{{ transaction.balanceAfter }}</td>
                        <td class="py-3 text-muted-foreground [font-variant-numeric:tabular-nums]">{{ transaction.createdAt|date('Y-m-d H:i') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {% if ledger.total > ledger.perPage %}
            <div class="mt-4 flex items-center gap-4 text-sm">
                <a
                    href="{{ ledger.hasPrevious ? path('app_admin_users_show', { publicId: targetUser.publicId, page: ledger.page - 1 }) : '#' }}"
                    class="flex items-center gap-1 rounded-md border border-border px-3 py-1.5 {{ ledger.hasPrevious ? 'hover:bg-secondary' : 'pointer-events-none opacity-40' }}"
                >
                    {{ icons.icon('arrow-left', 'size-3.5') }}
                    Previous
                </a>
                <span class="text-muted-foreground">Page {{ ledger.page }} of {{ ledger.lastPage }}</span>
                <a
                    href="{{ ledger.hasNext ? path('app_admin_users_show', { publicId: targetUser.publicId, page: ledger.page + 1 }) : '#' }}"
                    class="flex items-center gap-1 rounded-md border border-border px-3 py-1.5 {{ ledger.hasNext ? 'hover:bg-secondary' : 'pointer-events-none opacity-40' }}"
                >
                    Next
                    {{ icons.icon('arrow-right', 'size-3.5') }}
                </a>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
