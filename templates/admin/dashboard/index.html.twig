{% extends 'admin/_layout.html.twig' %}
{% import '_macros/icons.html.twig' as icons %}
{% block title %}Admin Dashboard — SmartGPX{% endblock %}
{% block admin_body %}
    <h1 class="text-2xl font-semibold">Dashboard</h1>

    <p class="mt-6 text-xs font-medium uppercase tracking-wide text-muted-foreground">Users &amp; conversions</p>
    <dl class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-4">
        {% for row in [
            { icon: 'users', label: 'Total users', value: metrics.totalUsers },
            { icon: 'route', label: 'Successful conversions', value: metrics.totalSuccessfulConversions },
            { icon: 'triangle-alert', label: 'Failed conversions', value: metrics.totalFailedConversions },
            { icon: 'package', label: 'Active credit packs', value: metrics.activeCreditPackCount },
        ] %}
            <div class="rounded-md border border-border p-4">
                <dt class="flex items-center gap-1.5 text-sm text-muted-foreground">
                    {{ icons.icon(row.icon, 'size-4') }}
                    {{ row.label }}
                </dt>
                <dd class="mt-1 text-2xl font-semibold [font-variant-numeric:tabular-nums]">{{ row.value }}</dd>
            </div>
        {% endfor %}
    </dl>

    <p class="mt-8 text-xs font-medium uppercase tracking-wide text-muted-foreground">Credits &amp; revenue</p>
    <dl class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-4">
        {% for row in [
            { icon: 'infinity', label: 'Credits issued', value: metrics.totalCreditsIssued },
            { icon: 'download', label: 'Credits consumed', value: metrics.totalCreditsConsumed },
            { icon: 'credit-card', label: 'Completed purchases', value: metrics.totalCompletedPurchases },
            { icon: 'credit-card', label: 'Revenue', value: '$' ~ (metrics.totalRevenueCents / 100)|number_format(2) },
        ] %}
            <div class="rounded-md border border-border p-4">
                <dt class="flex items-center gap-1.5 text-sm text-muted-foreground">
                    {{ icons.icon(row.icon, 'size-4') }}
                    {{ row.label }}
                </dt>
                <dd class="mt-1 text-2xl font-semibold [font-variant-numeric:tabular-nums]">{{ row.value }}</dd>
            </div>
        {% endfor %}
    </dl>
{% endblock %}
