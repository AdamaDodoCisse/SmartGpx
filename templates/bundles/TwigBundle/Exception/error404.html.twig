{% extends 'base.html.twig' %}

{% block title %}{{ 'error.404.title'|trans }} — SmartGPX{% endblock %}

{% block body %}
    <div class="mx-auto max-w-2xl px-4 py-24 text-center">
        <h1 class="text-3xl font-semibold">{{ 'error.404.title'|trans }}</h1>
        <p class="mt-4 text-muted-foreground">{{ 'error.404.description'|trans }}</p>
        <a href="{{ path('app_home') }}" class="mt-6 inline-block rounded-md bg-primary px-6 py-2 text-sm font-medium text-primary-foreground">
            {{ 'error.404.back_home'|trans }}
        </a>
    </div>
{% endblock %}
