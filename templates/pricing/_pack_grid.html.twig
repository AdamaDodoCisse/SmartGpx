{# Grille de cartes crédit — extraite (Phase 9) pour être partagée entre /pricing et la nouvelle
   section tarifs de la page d'accueil : une seule source de vérité pour une carte de pack
   (prix, badge, formulaire de paiement réel), pas une copie qui peut diverger. #}
<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {% for pack in packs %}
        {# Popular reste "mis en avant" via bordure/ombre uniquement, jamais une classe bg-* :
           cette carte est aussi incluse dans .hero-card-scope sur la page d'accueil (voir
           CLAUDE.md, gotcha Tailwind) — un fond en dur y casserait l'héritage de couleur clair
           forcé par ce scope. #}
        {% set is_popular = pack.badge is not null and 'most_popular' == pack.badge.value %}
        <div class="rounded-lg border p-6 {{ is_popular ? 'border-2 border-primary shadow-md' : 'border-border' }}">
            {# Emplacement de hauteur fixe, occupé ou non : sans ça, le badge "Most
               Popular" décale le prix vers le bas uniquement sur le pack qui en a un,
               et les prix/boutons ne s'alignent plus entre eux sur une même ligne de la grille. #}
            <div class="flex h-6 items-center">
                {% if pack.badge is not null %}
                    <span class="inline-block rounded-full bg-accent px-3 py-1 text-xs font-medium text-accent-foreground">{{ ('pricing.badge.' ~ pack.badge.value)|trans }}</span>
                {% endif %}
            </div>
            <p class="mt-3 text-2xl font-semibold">${{ (pack.priceCents / 100)|number_format(2) }}</p>
            <p class="text-muted-foreground">{{ 'pricing.credits_count'|trans({ '%count%': pack.credits }) }}</p>
            <p class="mt-1 text-sm text-muted-foreground">${{ (pack.priceCents / 100 / pack.credits)|number_format(3) }} {{ 'pricing.per_conversion'|trans }}</p>
            <p class="mt-2 text-sm text-muted-foreground">{{ ('pricing.tagline.' ~ pack.analyticsSlug)|trans }}</p>
            {% if app.user %}
                {# data-begin-checkout : capté par un écouteur délégué unique dans base.html.twig
                   (pas un écouteur par formulaire) puisque cette grille est incluse à la fois
                   sur /pricing et sur la section tarifs de la page d'accueil — voir
                   documentation/technique/google-tag-manager.md. data-pack-id reste l'UUID (c'est
                   ce que le routing/checkout utilise) ; data-pack-slug est un identifiant distinct,
                   stable, réservé à l'analytics (voir CreditPackSlug). #}
                <form
                    method="post"
                    action="{{ path('app_billing_checkout_create', { publicId: pack.publicId }) }}"
                    data-begin-checkout
                    data-pack-id="{{ pack.publicId }}"
                    data-pack-slug="{{ pack.analyticsSlug }}"
                    data-credits="{{ pack.credits }}"
                    data-price="{{ (pack.priceCents / 100)|number_format(2, '.', '') }}"
                    data-currency="{{ pack.currency }}"
                >
                    <input type="hidden" name="_token" value="{{ csrf_token('billing_checkout') }}">
                    <button type="submit" class="mt-4 w-full rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground">
                        {{ 'pricing.buy'|trans({ '%count%': pack.credits }) }}
                    </button>
                </form>
            {% else %}
                <a href="{{ path('app_login') }}" class="mt-4 block w-full rounded-md border border-border px-4 py-2 text-center text-sm font-medium text-muted-foreground">
                    {{ 'pricing.sign_in_to_buy'|trans }}
                </a>
            {% endif %}
        </div>
    {% endfor %}
</div>
