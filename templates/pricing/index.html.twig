{% extends 'base.html.twig' %}

{% block title %}{{ 'pricing.title'|trans }} — SmartGPX{% endblock %}

{% block body %}
    <div class="mx-auto max-w-6xl px-4 py-12">
        <h1 class="text-3xl font-display tracking-tight">{{ 'pricing.title'|trans }}</h1>
        <p class="mt-2 text-muted-foreground">{{ 'pricing.subtitle'|trans }}</p>

        <div class="mt-10">
            {% include 'pricing/_pack_grid.html.twig' %}
        </div>

        <div class="mt-10 space-y-1 text-sm text-muted-foreground">
            <p>{{ 'pricing.message.simple'|trans }}</p>
            <p>{{ 'pricing.message.buy_once'|trans }}</p>
            <p>{{ 'pricing.message.never_expire'|trans }}</p>
            <p>{{ 'pricing.message.one_conversion_one_credit'|trans }}</p>
            <p>{{ 'home.hero.free_conversion_notice'|trans }}</p>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'pricing_viewed' });
    </script>
{% endblock %}
