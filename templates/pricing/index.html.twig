{% extends 'base.html.twig' %}

{% block title %}{{ 'pricing.title'|trans }} — SmartGPX{% endblock %}

{% block body %}
    <div class="mx-auto max-w-6xl px-4 py-12">
        <h1 class="text-3xl font-semibold">{{ 'pricing.title'|trans }}</h1>
        <p class="mt-2 text-muted-foreground">{{ 'pricing.subtitle'|trans }}</p>

        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {% for pack in packs %}
                <div class="rounded-lg border border-border p-6">
                    {% if pack.badge is not null %}
                        <span class="inline-block rounded-full bg-accent px-3 py-1 text-xs font-medium text-accent-foreground">{{ ('pricing.badge.' ~ pack.badge.value)|trans }}</span>
                    {% endif %}
                    <p class="mt-3 text-2xl font-semibold">${{ (pack.priceCents / 100)|number_format(2) }}</p>
                    <p class="text-muted-foreground">{{ 'pricing.credits_count'|trans({ '%count%': pack.credits }) }}</p>
                    <p class="mt-1 text-sm text-muted-foreground">${{ (pack.priceCents / 100 / pack.credits)|number_format(3) }} {{ 'pricing.per_conversion'|trans }}</p>
                    {% if app.user %}
                        <form method="post" action="{{ path('app_billing_checkout_create', { publicId: pack.publicId }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('billing_checkout') }}">
                            <button type="submit" class="mt-4 w-full rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground">
                                {{ 'pricing.buy'|trans({ '%count%': pack.credits }) }}
                            </button>
                        </form>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="mt-4 block w-full rounded-md border border-border px-4 py-2 text-center text-sm font-medium text-muted-foreground">
                            {{ 'pricing.sign_in_to_buy'|trans }}
                        </a>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

        <div class="mt-10 space-y-1 text-sm text-muted-foreground">
            <p>{{ 'pricing.one_credit_equals'|trans }}</p>
            <p>{{ 'pricing.credits_never_expire'|trans }}</p>
        </div>
    </div>
{% endblock %}
