{% import '_macros/icons.html.twig' as icons %}
{# Liens "ressources associées" partagés par le cluster de guides — variable attendue : `links`,
   une liste de { route, icon, label } (label déjà traduit, contrairement à
   tools/_related.html.twig qui prend une clé : les libellés ici mélangent des clés de
   traduction propres au guide et des clés home.free_tools.* réutilisées, donc traduits par
   l'appelant plutôt que par ce partiel). #}
<div class="mt-12 border-t border-border pt-8">
    <p class="font-mono text-xs tracking-[0.15em] text-muted-foreground">{{ 'guides.related.heading'|trans }}</p>
    <ul class="mt-4 grid gap-px overflow-hidden rounded-lg border border-border bg-border {{ links|length == 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2' }}">
        {% for item in links %}
            <li class="bg-background p-4">
                <a href="{{ path(item.route) }}" class="flex items-center justify-between gap-2 text-sm hover:text-primary">
                    <span class="flex items-center gap-2">{{ icons.icon(item.icon, 'size-4 text-primary') }}{{ item.label }}</span>
                    {{ icons.icon('arrow-right', 'size-3.5 text-muted-foreground') }}
                </a>
            </li>
        {% endfor %}
    </ul>
</div>
