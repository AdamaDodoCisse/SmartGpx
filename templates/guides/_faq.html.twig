{% import '_macros/icons.html.twig' as icons %}
{# FAQ partagée, paramétrée par `namespace` (préfixe de clé de traduction, ex.
   guides.google_maps_to_garmin.faq) et `keys` (liste de suffixes courts) — même idiome que la
   FAQ de la page d'accueil (accordéon <details> + JSON-LD FAQPage généré depuis la même liste,
   donc jamais désynchronisé du contenu visible), extrait ici car réutilisé 3 fois à l'identique
   par le cluster Garmin/Wahoo/OsmAnd. #}
<div class="mt-12 border-t border-border pt-8">
    <h2 class="font-display text-xl tracking-tight">{{ 'guides.faq.heading'|trans }}</h2>
    <div class="mt-2 divide-y divide-border">
        {% for key in keys %}
            <details class="group py-4">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium marker:content-none [&::-webkit-details-marker]:hidden">
                    {{ (namespace ~ '.' ~ key ~ '_title')|trans }}
                    {{ icons.icon('chevron-down', 'size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180') }}
                </summary>
                <p class="mt-3 text-sm text-muted-foreground">{{ (namespace ~ '.' ~ key ~ '_body')|trans }}</p>
            </details>
        {% endfor %}
    </div>
</div>
<script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {% for key in keys %}
                {
                    "@type": "Question",
                    "name": {{ (namespace ~ '.' ~ key ~ '_title')|trans|json_encode|raw }},
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": {{ (namespace ~ '.' ~ key ~ '_body')|trans|json_encode|raw }}
                    }
                }{% if not loop.last %},{% endif %}
            {% endfor %}
        ]
    }
</script>
