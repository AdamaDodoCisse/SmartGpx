{% extends 'base.html.twig' %}
{% import '_macros/icons.html.twig' as icons %}

{% block title %}{{ 'guides.index.meta_title'|trans }} — SmartGPX{% endblock %}
{% block meta_description %}{{ 'guides.index.meta_description'|trans }}{% endblock %}

{% block body %}
    <div id="guides-index" class="mx-auto max-w-4xl px-4 py-12">
        <h1 class="text-center text-3xl font-display tracking-tight">{{ 'guides.index.title'|trans }}</h1>
        <p class="mt-2 text-center text-muted-foreground">{{ 'guides.index.intro'|trans }}</p>

        <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {% for guide, entry in {
                gpx_vs_kml: { route: 'app_guides_gpx_vs_kml', icon: 'file-code' },
                gpx_vs_tcx: { route: 'app_guides_gpx_vs_tcx', icon: 'activity' },
                gpx_vs_fit: { route: 'app_guides_gpx_vs_fit', icon: 'watch' },
                gpx_vs_geojson: { route: 'app_guides_gpx_vs_geojson', icon: 'braces' },
                google_maps_to_gpx: { route: 'app_guides_google_maps_to_gpx', icon: 'map-pin' },
                kmz: { route: 'app_guides_kmz', icon: 'file-archive' },
                simplify_track: { route: 'app_guides_simplify_track', icon: 'sparkles' },
                merge_tracks: { route: 'app_guides_merge_tracks', icon: 'combine' },
                google_maps_to_garmin: { route: 'app_guides_google_maps_to_garmin', icon: 'route' },
                google_maps_to_wahoo: { route: 'app_guides_google_maps_to_wahoo', icon: 'bike' },
                google_maps_to_osmand: { route: 'app_guides_google_maps_to_osmand', icon: 'navigation' },
            } %}
                <li class="rounded-md border border-border p-4">
                    <a href="{{ path(entry.route) }}" class="flex items-start gap-3 hover:text-foreground">
                        <span class="mt-0.5 shrink-0 text-primary">{{ icons.icon(entry.icon, 'size-5') }}</span>
                        <span>
                            <span class="block font-medium">{{ ('guides.' ~ guide ~ '.title')|trans }}</span>
                            <span class="mt-1 block text-sm text-muted-foreground">{{ ('guides.' ~ guide ~ '.intro')|trans }}</span>
                        </span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
