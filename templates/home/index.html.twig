{% extends 'base.html.twig' %}
{% import '_macros/icons.html.twig' as icons %}

{% block title %}SmartGPX — {{ 'home.hero.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'home.hero.subtitle'|trans }}{% endblock %}

{% block body %}
    <div class="border-b border-border">
        <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:py-24">
            <div>
                <p class="font-mono text-xs font-medium tracking-[0.2em] text-route">{{ 'home.hero.eyebrow'|trans }}</p>
                <h1 class="mt-4 font-display text-4xl leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">{{ 'home.hero.title'|trans }}</h1>
                <p class="mt-5 max-w-md text-lg text-muted-foreground">{{ 'home.hero.subtitle'|trans }}</p>

                <div
                    id="convert-hero-root"
                    class="mt-8"
                    data-is-authenticated="{{ app.user ? '1' : '' }}"
                    data-csrf-token="{{ csrf_token('convert_google_maps') }}"
                    data-credit-balance="{{ creditBalance }}"
                    data-locale="{{ app.request.locale }}"
                ></div>

                <p class="mt-6 text-sm text-muted-foreground">{{ 'home.compatibility'|trans }}</p>
            </div>

            {# Élément signature : une trace GPX qui se dessine du départ jusqu'au point de
               position actuel — purement décoratif, aria-hidden car aucune information n'y est
               encodée qui ne soit déjà dans le titre/sous-titre. #}
            <svg viewBox="0 0 400 320" class="mx-auto hidden w-full max-w-sm sm:block lg:max-w-none" aria-hidden="true" focusable="false">
                <path class="route-line-path" d="M20,290 C70,270 60,190 120,180 C170,172 175,235 225,205 C270,178 260,95 320,88 C345,85 355,55 380,32" />
                <circle class="route-line-waypoint" cx="20" cy="290" r="6" style="--delay: 0.1s"/>
                <circle class="route-line-waypoint" cx="225" cy="205" r="6" style="--delay: 0.9s"/>
                <circle class="route-line-live" cx="380" cy="32" r="7"/>
            </svg>
        </div>
    </div>

    {{ vite_entry_script_tags('convertHero', { dependency: 'react' }) }}

    <div class="contour-bg border-t border-border bg-secondary/40">
        <div class="mx-auto max-w-5xl px-4 py-16 lg:py-20">
            <h2 class="text-center font-display text-2xl tracking-tight sm:text-3xl">{{ 'home.how_it_works.title'|trans }}</h2>
            <ol class="mt-12 grid grid-cols-1 gap-10 sm:grid-cols-3">
                {% for step, icon in { 1: 'clipboard-paste', 2: 'route', 3: 'download' } %}
                    <li class="text-center">
                        <div class="mx-auto flex size-12 items-center justify-center rounded-full border border-route/30 bg-background text-route">
                            {{ icons.icon(icon, 'size-6') }}
                        </div>
                        <p class="mt-3 font-mono text-xs tracking-[0.2em] text-muted-foreground" aria-hidden="true">{{ '%02d'|format(step) }} / 03</p>
                        <h3 class="mt-1 font-semibold">{{ ('home.how_it_works.step_' ~ step ~ '_title')|trans }}</h3>
                        <p class="mt-2 text-sm text-muted-foreground">{{ ('home.how_it_works.step_' ~ step ~ '_body')|trans }}</p>
                    </li>
                {% endfor %}
            </ol>
        </div>
    </div>

    <div class="mx-auto max-w-5xl px-4 py-16">
        <ul class="grid grid-cols-1 gap-8 sm:grid-cols-3">
            {% for benefit, icon in { device: 'watch', privacy: 'shield-check', credits: 'infinity' } %}
                <li class="flex gap-3">
                    <span class="mt-0.5 shrink-0 text-primary">
                        {{ icons.icon(icon, 'size-5') }}
                    </span>
                    <span>
                        <span class="block font-medium">{{ ('home.benefits.' ~ benefit ~ '_title')|trans }}</span>
                        <span class="mt-1 block text-sm text-muted-foreground">{{ ('home.benefits.' ~ benefit ~ '_body')|trans }}</span>
                    </span>
                </li>
            {% endfor %}
        </ul>
    </div>

    <div id="free-tools" class="mx-auto max-w-6xl px-4 pb-16">
        <h2 class="text-center text-2xl font-semibold">{{ 'home.free_tools.title'|trans }}</h2>
        <ul class="mt-6 grid grid-cols-2 gap-3 text-center text-sm text-muted-foreground sm:grid-cols-3 md:grid-cols-4">
            {% for tool, entry in {
                gpx_to_google_maps: { route: 'app_tools_gpx_to_google_maps', icon: 'map-pin' },
                gpx_simplify: { route: 'app_tools_gpx_simplify', icon: 'sparkles' },
                gpx_merge: { route: 'app_tools_gpx_merge', icon: 'combine' },
                kml_to_gpx: { route: 'app_tools_kml_to_gpx', icon: 'file-code' },
                gpx_to_kml: { route: 'app_tools_gpx_to_kml', icon: 'file-code' },
                kmz_to_gpx: { route: 'app_tools_kmz_to_gpx', icon: 'file-archive' },
                tcx_to_gpx: { route: 'app_tools_tcx_to_gpx', icon: 'activity' },
                gpx_to_tcx: { route: 'app_tools_gpx_to_tcx', icon: 'activity' },
                fit_to_gpx: { route: 'app_tools_fit_to_gpx', icon: 'watch' },
                gpx_to_fit: { route: 'app_tools_gpx_to_fit', icon: 'watch' },
                geojson_to_gpx: { route: 'app_tools_geojson_to_gpx', icon: 'braces' },
                gpx_to_geojson: { route: 'app_tools_gpx_to_geojson', icon: 'braces' },
                gpx_viewer: { route: 'app_gpx_viewer', icon: 'map' },
            } %}
                <li class="rounded-md border border-border px-3 py-4">
                    {% if entry.route is not null %}
                        <a href="{{ path(entry.route) }}" class="flex flex-col items-center gap-2 hover:text-foreground">
                            {{ icons.icon(entry.icon, 'size-5 text-primary') }}
                            {{ ('home.free_tools.' ~ tool)|trans }}
                        </a>
                    {% else %}
                        <span class="flex flex-col items-center gap-2">
                            {{ icons.icon(entry.icon, 'size-5') }}
                            {{ ('home.free_tools.' ~ tool)|trans }}
                        </span>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
        <p class="mt-4 text-center text-xs text-muted-foreground">{{ 'home.free_tools.coming_soon'|trans }}</p>
    </div>
{% endblock %}
