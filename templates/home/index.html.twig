{% extends 'base.html.twig' %}

{% block title %}SmartGPX — {{ 'home.hero.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'home.hero.subtitle'|trans }}{% endblock %}

{% block body %}
    <div class="mx-auto max-w-4xl px-4 py-16 text-center">
        <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">SmartGPX</h1>
        <p class="mt-4 text-xl text-muted-foreground">{{ 'home.hero.title'|trans }}</p>
        <p class="mt-2 text-muted-foreground">{{ 'home.hero.subtitle'|trans }}</p>

        <div
            id="convert-hero-root"
            data-is-authenticated="{{ app.user ? '1' : '' }}"
            data-csrf-token="{{ csrf_token('convert_google_maps') }}"
            data-credit-balance="{{ creditBalance }}"
            data-locale="{{ app.request.locale }}"
        ></div>

        <p class="mt-12 text-sm text-muted-foreground">{{ 'home.compatibility'|trans }}</p>
    </div>

    {{ vite_entry_script_tags('convertHero', { dependency: 'react' }) }}

    <div class="mx-auto max-w-6xl px-4 pb-16">
        <h2 class="text-center text-2xl font-semibold">{{ 'home.free_tools.title'|trans }}</h2>
        <ul class="mt-6 grid grid-cols-2 gap-3 text-center text-sm text-muted-foreground sm:grid-cols-3 md:grid-cols-4">
            {% for tool, route in {
                gpx_to_google_maps: 'app_tools_gpx_to_google_maps',
                gpx_simplify: 'app_tools_gpx_simplify',
                gpx_merge: 'app_tools_gpx_merge',
                kml_to_gpx: 'app_tools_kml_to_gpx',
                gpx_to_kml: 'app_tools_gpx_to_kml',
                kmz_to_gpx: null,
                tcx_to_gpx: null,
                gpx_to_tcx: null,
                fit_to_gpx: null,
                gpx_to_fit: null,
                geojson_to_gpx: null,
                gpx_to_geojson: null,
                gpx_viewer: 'app_gpx_viewer',
            } %}
                <li class="rounded-md border border-border px-3 py-4">
                    {% if route is not null %}
                        <a href="{{ path(route) }}" class="hover:text-foreground">{{ ('home.free_tools.' ~ tool)|trans }}</a>
                    {% else %}
                        {{ ('home.free_tools.' ~ tool)|trans }}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
        <p class="mt-4 text-center text-xs text-muted-foreground">{{ 'home.free_tools.coming_soon'|trans }}</p>
    </div>
{% endblock %}
